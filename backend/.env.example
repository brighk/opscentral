OC_DATABASE_URL=postgresql+asyncpg://opscentral:opscentral_dev@localhost:5432/opscentral
OC_REDIS_URL=redis://localhost:6379/0
OC_SECRET_KEY=change-me-in-production
OC_CORS_ORIGINS=["http://localhost:5173"]

# Stripe
OC_STRIPE_SECRET_KEY=sk_test_...
OC_STRIPE_WEBHOOK_SECRET=whsec_...
OC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Frontend URL (for Stripe redirects)
OC_FRONTEND_URL=http://localhost:5173

# Outbound requests (runbook webhooks, Jira/ServiceNow) may only target public
# addresses. Set to true on self-hosted installs that need to reach internal hosts.
OC_ALLOW_PRIVATE_NETWORK_TARGETS=false
